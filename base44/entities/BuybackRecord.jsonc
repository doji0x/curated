{
  "name": "BuybackRecord",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "default": "creator rewards"
    },
    "totalAccrued": {
      "type": "string",
      "description": "Verified newly collected rewards in lamports"
    },
    "sweptBps": {
      "type": "number",
      "default": 8000
    },
    "sweptAmount": {
      "type": "string",
      "description": "Actual finalized SOL quote spend including trading fees for cycle receipts; legacy records may store a budget, in lamports"
    },
    "buyMint": {
      "type": "string"
    },
    "coinsReceived": {
      "type": "string"
    },
    "tokenDecimals": {
      "type": "number"
    },
    "signature": {
      "type": "string"
    },
    "wallet": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "failed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    },
    "remainingBalance": {
      "type": "string"
    },
    "networkFee": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "lastValidBlockHeight": {
      "type": "number"
    },
    "signedTransaction": {
      "type": "string",
      "description": "Bounded signed transaction for same-signature rebroadcast, cleared after settlement"
    },
    "pumpVault": {
      "type": "string"
    },
    "pumpRent": {
      "type": "string"
    },
    "ammVault": {
      "type": "string"
    },
    "collectPump": {
      "type": "boolean"
    },
    "collectAmm": {
      "type": "boolean"
    },
    "claimVersion": {
      "type": "number",
      "description": "1 identifies a verified claim-only receipt; older records retain legacy settlement."
    },
    "claimPlan": {
      "type": "object",
      "description": "Server-verified source vaults, route, recipient and attribution captured before signing."
    },
    "claimScope": {
      "type": "string",
      "description": "mint for fee-sharing distributions; creator-wallet for pooled direct collections."
    },
    "attributedMint": {
      "type": "string",
      "description": "Only populated when source fees are isolated by mint."
    },
    "quoteMint": {
      "type": "string",
      "description": "Reward asset mint; this claim action accepts SOL only."
    },
    "messageHash": {
      "type": "string",
      "description": "SHA-256 of the approved claim or cycle transaction message."
    },
    "rentRefund": {
      "type": "string",
      "description": "Account rent returned during a claim or empty-account cleanup; excluded from reward buying power."
    },
    "unwrappedExisting": {
      "type": "string",
      "description": "Existing recipient WSOL unwrapped by SDK; excluded from rewards."
    },
    "totalDistributed": {
      "type": "string",
      "description": "Actual reward vault outflow; can exceed this wallet\u2019s receipt for multiple shareholders."
    },
    "cycleVersion": {
      "type": "number"
    },
    "cycleId": {
      "type": "string"
    },
    "cycleStep": {
      "type": "string"
    },
    "epoch": {
      "type": "string"
    },
    "stepPlan": {
      "type": "object"
    },
    "burnedAmount": {
      "type": "string"
    }
  },
  "required": [
    "source",
    "wallet",
    "buyMint",
    "status",
    "signature",
    "createdAt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
