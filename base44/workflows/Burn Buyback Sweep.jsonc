  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "burn_buyback_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep_rewards": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "executeBurnBuyback",
